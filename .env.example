# Copy this file to /var/lib/relayquay/relayquay.env.
# Keep the copied file private and out of Git.

# Main hostname routed through Cloudflare Tunnel.
# In rustdesk mode, protect this hostname with Cloudflare Access.
# In app mode, use this as the public cover hostname and do not attach Access.
RELAYQUAY_PUBLIC_HOST=relayquay.example.com

# Gateway mode:
# - rustdesk: proxy RustDesk WebSocket endpoints.
# - app: proxy a separate loopback HTTP/WebSocket app such as RustOpViewer.
RELAYQUAY_GATEWAY=rustdesk

# Runtime mode:
# - active: serve the configured gateway.
# - cover: serve the neutral Not Found cover response.
RELAYQUAY_MODE=active

# Local loopback listener used by cloudflared.
RELAYQUAY_BIND=127.0.0.1
RELAYQUAY_LISTEN_PORT=8788

# Private state and existing RustDesk data.
RELAYQUAY_STATE_DIR=/var/lib/relayquay
RUSTDESK_DATA_DIR=/var/lib/relayquay/rustdesk

# Optional self-hosted RustDesk web client static files.
# Keep this disabled unless you provide trusted static assets yourself.
RELAYQUAY_WEBCLIENT=0
# Use / to serve the web client at the protected hostname root.
RELAYQUAY_WEBCLIENT_PATH=/sky
RUSTDESK_WEB_ROOT=/var/lib/relayquay/webclient

# Existing RustDesk WebSocket upstreams.
RUSTDESK_HBBS_WS_UPSTREAM=127.0.0.1:21118
RUSTDESK_HBBR_WS_UPSTREAM=127.0.0.1:21119

# Generic private app mode. Run the app on loopback and protect this hostname
# separately with Cloudflare Access. RelayQuay does not bundle that app.
RELAYQUAY_APP_HOST=relayquay-private.example.com
RELAYQUAY_APP_UPSTREAM=127.0.0.1:45080

# Cloudflare Tunnel token. Set this only in the private env file.
CLOUDFLARE_TUNNEL_TOKEN="<your-cloudflare-tunnel-token>"

# Network and lifecycle controls.
RELAYQUAY_RESTART_POLICY=unless-stopped
CLOUDFLARED_PROTOCOL=quic

# Optional RustDesk server profile. Leave COMPOSE_PROFILES unset for gateway-only.
RUSTDESK_SERVER_TAG=latest
RUSTDESK_HBBS_COMMAND="hbbs -r ${RELAYQUAY_PUBLIC_HOST}:443"
RUSTDESK_HBBR_COMMAND=hbbr

# Image tags.
CADDY_TAG=2-alpine
CLOUDFLARED_TAG=2026.6.1
