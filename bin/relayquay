#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${RELAYQUAY_ENV_FILE:-/var/lib/relayquay/relayquay.env}"
COMPOSE_DIR="$ROOT_DIR/deploy/compose"

usage() {
  cat <<'USAGE'
RelayQuay - private tunnel gateway helper

Usage:
  relayquay init
  relayquay doctor
  relayquay pause
  relayquay cover
  relayquay activate
  relayquay up [service...]
  relayquay down
  relayquay stop [service...]
  relayquay status
  relayquay logs [service...]
  relayquay config
  relayquay key

Environment:
  RELAYQUAY_ENV_FILE=/var/lib/relayquay/relayquay.env
USAGE
}

load_env() {
  if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
  fi

  RELAYQUAY_STATE_DIR="${RELAYQUAY_STATE_DIR:-/var/lib/relayquay}"
  RELAYQUAY_BIND="${RELAYQUAY_BIND:-127.0.0.1}"
  RELAYQUAY_LISTEN_PORT="${RELAYQUAY_LISTEN_PORT:-8788}"
  RELAYQUAY_RESTART_POLICY="${RELAYQUAY_RESTART_POLICY:-unless-stopped}"
  CLOUDFLARED_PROTOCOL="${CLOUDFLARED_PROTOCOL:-quic}"
  RELAYQUAY_LEGACY_ROV_CONFIG=0
  if [[ -z "${RELAYQUAY_GATEWAY:-}" && -n "${ROV_UPSTREAM:-}" ]]; then
    RELAYQUAY_GATEWAY="rustopviewer"
    RELAYQUAY_LEGACY_ROV_CONFIG=1
  fi
  RELAYQUAY_GATEWAY="${RELAYQUAY_GATEWAY:-rustdesk}"
  if [[ "$RELAYQUAY_LEGACY_ROV_CONFIG" == "1" && -z "${RELAYQUAY_MODE:-}" ]]; then
    RELAYQUAY_MODE="cover"
  else
    RELAYQUAY_MODE="${RELAYQUAY_MODE:-active}"
  fi
  RELAYQUAY_APP_HOST="${RELAYQUAY_APP_HOST:-${RELAYQUAY_ACCESS_HOST:-}}"
  if [[ "${RELAYQUAY_APP_HOST:-}" == "" ]]; then
    RELAYQUAY_APP_HOST="relayquay-app.invalid"
  fi
  RELAYQUAY_USING_ROV_UPSTREAM=0
  if [[ -z "${RELAYQUAY_APP_UPSTREAM:-}" && -n "${ROV_UPSTREAM:-}" ]]; then
    RELAYQUAY_APP_UPSTREAM="$ROV_UPSTREAM"
    RELAYQUAY_USING_ROV_UPSTREAM=1
  fi
  RELAYQUAY_APP_UPSTREAM="${RELAYQUAY_APP_UPSTREAM:-127.0.0.1:45080}"
  RUSTDESK_DATA_DIR="${RUSTDESK_DATA_DIR:-/var/lib/relayquay/rustdesk}"
  RELAYQUAY_WEBCLIENT="${RELAYQUAY_WEBCLIENT:-0}"
  RELAYQUAY_WEBCLIENT_PATH="${RELAYQUAY_WEBCLIENT_PATH:-/sky}"
  if [[ "$RELAYQUAY_WEBCLIENT_PATH" != "/" ]]; then
    RELAYQUAY_WEBCLIENT_PATH="/${RELAYQUAY_WEBCLIENT_PATH#/}"
    RELAYQUAY_WEBCLIENT_PATH="${RELAYQUAY_WEBCLIENT_PATH%/}"
  fi
  export RELAYQUAY_WEBCLIENT_PATH
  RUSTDESK_WEB_ROOT="${RUSTDESK_WEB_ROOT:-$RELAYQUAY_STATE_DIR/webclient}"
  RUSTDESK_HBBS_WS_UPSTREAM="${RUSTDESK_HBBS_WS_UPSTREAM:-127.0.0.1:21118}"
  RUSTDESK_HBBR_WS_UPSTREAM="${RUSTDESK_HBBR_WS_UPSTREAM:-127.0.0.1:21119}"

  case "${RELAYQUAY_MODE,,}" in
    active|on|live)
      RELAYQUAY_MODE="active"
      ;;
    cover|covered|pause|paused)
      RELAYQUAY_MODE="cover"
      ;;
    *)
      echo "error: RELAYQUAY_MODE must be active or cover" >&2
      exit 2
      ;;
  esac

  case "${RELAYQUAY_GATEWAY,,}" in
    rustdesk|wss)
      RELAYQUAY_GATEWAY="rustdesk"
      ;;
    rustopviewer|rov)
      RELAYQUAY_GATEWAY="rustopviewer"
      ;;
    app|http|upstream)
      RELAYQUAY_GATEWAY="app"
      ;;
    *)
      echo "error: RELAYQUAY_GATEWAY must be rustopviewer, app, or rustdesk" >&2
      exit 2
      ;;
  esac

  case "$RELAYQUAY_MODE:$RELAYQUAY_GATEWAY" in
    cover:*)
      RELAYQUAY_CADDYFILE="${RELAYQUAY_CADDYFILE:-./deploy/caddy/Caddyfile.cover}"
      ;;
    active:app|active:rustopviewer)
      RELAYQUAY_CADDYFILE="${RELAYQUAY_CADDYFILE:-./deploy/caddy/Caddyfile.app}"
      ;;
    active:rustdesk)
      RELAYQUAY_CADDYFILE="${RELAYQUAY_CADDYFILE:-./deploy/caddy/Caddyfile}"
      ;;
  esac

  export RELAYQUAY_MODE RELAYQUAY_GATEWAY RELAYQUAY_APP_HOST RELAYQUAY_APP_UPSTREAM RELAYQUAY_CADDYFILE
  export RELAYQUAY_LEGACY_ROV_CONFIG RELAYQUAY_USING_ROV_UPSTREAM
}

app_gateway_enabled() {
  [[ "$RELAYQUAY_GATEWAY" == "app" || "$RELAYQUAY_GATEWAY" == "rustopviewer" ]]
}

require_active_app_host() {
  if [[ "$RELAYQUAY_MODE" == "active" ]] && app_gateway_enabled &&
    [[ "$RELAYQUAY_APP_HOST" == "relayquay-app.invalid" ]]; then
    echo "error: active $RELAYQUAY_GATEWAY mode requires RELAYQUAY_APP_HOST" >&2
    echo "error: set it to the Access-protected hostname; it may equal RELAYQUAY_PUBLIC_HOST for a one-host migration" >&2
    return 2
  fi
}

compose() {
  require_active_app_host
  local compose_files=(-f "$COMPOSE_DIR/compose.yaml")
  case "$RELAYQUAY_MODE:$RELAYQUAY_GATEWAY:${RELAYQUAY_WEBCLIENT,,}" in
    active:rustdesk:1|active:rustdesk:true|active:rustdesk:yes|active:rustdesk:on)
      if [[ "$RELAYQUAY_WEBCLIENT_PATH" == "/" ]]; then
        compose_files+=(-f "$COMPOSE_DIR/webclient-root.yaml")
      else
        compose_files+=(-f "$COMPOSE_DIR/webclient.yaml")
      fi
      ;;
  esac

  docker compose \
    --env-file "$ENV_FILE" \
    --project-directory "$ROOT_DIR" \
    "${compose_files[@]}" \
    "$@"
}

set_env_var() {
  local key="$1"
  local value="$2"
  local state_owner="${RELAYQUAY_STATE_OWNER:-${SUDO_USER:-${USER}}}"
  local state_group="${RELAYQUAY_STATE_GROUP:-$(id -gn "$state_owner")}"

  sudo install -d -o "$state_owner" -g "$state_group" -m 700 "$(dirname "$ENV_FILE")"
  if [[ ! -f "$ENV_FILE" ]]; then
    sudo install -o "$state_owner" -g "$state_group" -m 600 "$ROOT_DIR/.env.example" "$ENV_FILE"
  fi

  if grep -qE "^${key}=" "$ENV_FILE"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
  else
    printf '\n%s=%s\n' "$key" "$value" >>"$ENV_FILE"
  fi
}

webclient_enabled() {
  case "${RELAYQUAY_WEBCLIENT,,}" in
    1|true|yes|on)
      [[ "$RELAYQUAY_MODE" == "active" && "$RELAYQUAY_GATEWAY" == "rustdesk" ]]
      ;;
    *)
      return 1
      ;;
  esac
}

cmd_init() {
  local state_owner="${RELAYQUAY_STATE_OWNER:-${SUDO_USER:-${USER}}}"
  local state_group="${RELAYQUAY_STATE_GROUP:-$(id -gn "$state_owner")}"

  sudo install -d -o "$state_owner" -g "$state_group" -m 700 "$(dirname "$ENV_FILE")"
  if [[ ! -f "$ENV_FILE" ]]; then
    sudo install -o "$state_owner" -g "$state_group" -m 600 "$ROOT_DIR/.env.example" "$ENV_FILE"
    echo "created $ENV_FILE"
  else
    sudo chown "$state_owner:$state_group" "$ENV_FILE"
    sudo chmod 600 "$ENV_FILE"
    echo "kept existing $ENV_FILE"
  fi

  load_env
  sudo install -d -o "$state_owner" -g "$state_group" -m 700 "$RELAYQUAY_STATE_DIR"
  sudo install -d -o "$state_owner" -g "$state_group" -m 700 "$RELAYQUAY_STATE_DIR/caddy"
  if webclient_enabled; then
    sudo install -d -o "$state_owner" -g "$state_group" -m 755 "$RUSTDESK_WEB_ROOT"
  fi
}

cmd_doctor() {
  load_env
  local failed=0

  if command -v docker >/dev/null 2>&1; then
    echo "ok: docker is installed"
  else
    echo "error: docker is not installed"
    failed=1
  fi

  if [[ -f "$ENV_FILE" ]]; then
    echo "ok: private env file exists at $ENV_FILE"
  else
    echo "warn: private env file is missing; run ./bin/relayquay init"
  fi

  case "${CLOUDFLARE_TUNNEL_TOKEN:-}" in
    ""|"<your-cloudflare-tunnel-token>"|replace-me)
      echo "warn: CLOUDFLARE_TUNNEL_TOKEN is not set in the private env file"
      ;;
    *)
      echo "ok: Cloudflare tunnel token is set"
      ;;
  esac

  case "${RELAYQUAY_PUBLIC_HOST:-}" in
    ""|rov.example.com|rustdesk-wss.example.com|relayquay.example.com|relayquay-public.example.com)
      echo "warn: RELAYQUAY_PUBLIC_HOST is still an example value"
      ;;
    *)
      echo "ok: public hostname is configured"
      ;;
  esac

  echo "ok: mode is $RELAYQUAY_MODE"
  echo "ok: gateway is $RELAYQUAY_GATEWAY"
  if app_gateway_enabled; then
    if [[ "$RELAYQUAY_APP_HOST" == "relayquay-app.invalid" ]]; then
      echo "error: RELAYQUAY_APP_HOST is not set; app traffic will fail closed" >&2
      echo "error: set it to the Access-protected hostname before running activate" >&2
      failed=1
    else
      case "$RELAYQUAY_APP_HOST" in
        rov.example.com|relayquay-private.example.com)
          echo "warn: RELAYQUAY_APP_HOST is still an example value"
          ;;
        *)
          echo "ok: app hostname is configured"
          ;;
      esac
    fi
    if [[ "$RELAYQUAY_USING_ROV_UPSTREAM" == "1" ]]; then
      echo "warn: ROV_UPSTREAM is a compatibility alias; migrate it to RELAYQUAY_APP_UPSTREAM"
    fi
    if [[ "$RELAYQUAY_LEGACY_ROV_CONFIG" == "1" ]]; then
      echo "warn: legacy RustOpViewer config detected; cover mode is the migration default"
    fi
    check_app_listener "$RELAYQUAY_APP_UPSTREAM"
  fi
  case "$RELAYQUAY_MODE:$RELAYQUAY_GATEWAY" in
    active:app)
      check_tcp_upstream "$RELAYQUAY_APP_UPSTREAM" "private app"
      ;;
    active:rustopviewer)
      check_tcp_upstream "$RELAYQUAY_APP_UPSTREAM" "RustOpViewer"
      ;;
    active:rustdesk)
      check_tcp_upstream "$RUSTDESK_HBBS_WS_UPSTREAM" "hbbs WebSocket"
      check_tcp_upstream "$RUSTDESK_HBBR_WS_UPSTREAM" "hbbr WebSocket"
      check_webclient_assets
      check_raw_rustdesk_listeners
      ;;
    cover:*)
      echo "ok: cover mode serves the neutral cover response instead of an upstream"
      ;;
  esac

  if curl -fsS -H "Host: localhost" "http://${RELAYQUAY_BIND}:${RELAYQUAY_LISTEN_PORT}/healthz" >/dev/null 2>&1; then
    echo "ok: local gateway health endpoint is responding"
  else
    echo "warn: local gateway is not responding yet"
  fi

  return "$failed"
}

check_webclient_assets() {
  case "${RELAYQUAY_WEBCLIENT,,}" in
    1|true|yes|on)
      if [[ -r "$RUSTDESK_WEB_ROOT/index.html" ]]; then
        echo "ok: optional web client assets found at $RUSTDESK_WEB_ROOT"
        echo "ok: optional web client path is $RELAYQUAY_WEBCLIENT_PATH"
      else
        echo "warn: RELAYQUAY_WEBCLIENT is enabled but $RUSTDESK_WEB_ROOT/index.html is missing"
      fi
      ;;
  esac
}

check_tcp_upstream() {
  local upstream="$1"
  local label="$2"
  local host="${upstream%:*}"
  local port="${upstream##*:}"

  if timeout 2 bash -c ":</dev/tcp/${host}/${port}" >/dev/null 2>&1; then
    echo "ok: $label upstream reachable at $upstream"
  else
    echo "warn: $label upstream not reachable at $upstream"
  fi
}

check_app_listener() {
  local upstream="$1"
  local host="${upstream%:*}"
  local port="${upstream##*:}"

  case "$host" in
    127.0.0.1|localhost|\[::1\])
      ;;
    *)
      echo "warn: app upstream $upstream is not loopback; review its firewall exposure"
      ;;
  esac

  if ! command -v ss >/dev/null 2>&1 || [[ ! "$port" =~ ^[0-9]+$ ]]; then
    return 0
  fi

  local wildcard
  wildcard="$(ss -ltnH "sport = :$port" 2>/dev/null | awk '$4 ~ /^(0\.0\.0\.0|\*|\[::\]|::):[0-9]+$/ {print $1, $4}' || true)"
  if [[ -n "$wildcard" ]]; then
    echo "warn: app port $port is listening on a wildcard interface:"
    echo "$wildcard" | sed 's/^/  /'
    echo "warn: bind RustOpViewer/private apps to loopback or restrict this port with the host firewall"
  fi
}

check_raw_rustdesk_listeners() {
  if ! command -v ss >/dev/null 2>&1; then
    return 0
  fi

  local wildcard
  wildcard="$(ss -ltnuH 2>/dev/null | awk '$5 ~ /:(21115|21116|21117|21118|21119)$/ && $5 !~ /^(127\.0\.0\.1|\[::1\])/{print $1, $5}' || true)"
  if [[ -n "$wildcard" ]]; then
    echo "warn: raw RustDesk ports are listening beyond loopback:"
    echo "$wildcard" | sed 's/^/  /'
    echo "warn: restrict these with a host firewall unless they are private-network only"
  else
    echo "ok: no wildcard raw RustDesk listeners detected"
  fi
}

cmd_pause() {
  set_env_var RELAYQUAY_MODE cover
  load_env
  compose up -d --force-recreate caddy
  compose stop cloudflared
  echo "paused: cover mode is configured and cloudflared is stopped"
}

cmd_cover() {
  set_env_var RELAYQUAY_MODE cover
  load_env
  compose up -d --force-recreate caddy cloudflared
  echo "covered: cloudflared is running and Caddy serves the neutral cover response"
}

cmd_activate() {
  set_env_var RELAYQUAY_MODE active
  load_env
  compose up -d --force-recreate caddy cloudflared
  echo "active: cloudflared is running and Caddy serves the configured gateway"
}

cmd_key() {
  load_env
  local key_path="$RUSTDESK_DATA_DIR/id_ed25519.pub"
  if [[ ! -r "$key_path" ]]; then
    key_path="$RELAYQUAY_STATE_DIR/rustdesk/id_ed25519.pub"
  fi
  if [[ -r "$key_path" ]]; then
    cat "$key_path"
  else
    echo "RustDesk public key not found. Start hbbs once, then check $RUSTDESK_DATA_DIR/id_ed25519.pub" >&2
    return 1
  fi
}

cmd="${1:-help}"
case "$cmd" in
  init)
    cmd_init
    ;;
  doctor)
    cmd_doctor
    ;;
  pause)
    cmd_pause
    ;;
  cover)
    cmd_cover
    ;;
  activate)
    cmd_activate
    ;;
  up)
    load_env
    shift
    compose up -d "$@"
    ;;
  down)
    load_env
    compose down
    ;;
  stop)
    load_env
    shift
    compose stop "$@"
    ;;
  status|ps)
    load_env
    compose ps
    ;;
  logs)
    load_env
    shift
    compose logs -f --tail=200 "$@"
    ;;
  config)
    load_env
    # The rendered config carries the tunnel token as TUNNEL_TOKEN; never print it.
    compose config | sed -E 's/^([[:space:]]*TUNNEL_TOKEN:).*/\1 <redacted>/'
    ;;
  key)
    cmd_key
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
