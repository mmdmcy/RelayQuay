# Copy this file to a private path such as
# /var/lib/relayquay/relayquay.env, then replace every example value.

# RustOpViewer is kept behind the cover response until `relayquay activate`.
RELAYQUAY_GATEWAY=rustopviewer
RELAYQUAY_MODE=cover

# Route both hostnames through the same tunnel. Attach Cloudflare Access only
# to the app hostname. The public hostname remains a neutral cover endpoint.
RELAYQUAY_PUBLIC_HOST=relayquay-cover.example.com
RELAYQUAY_APP_HOST=rov.example.com

# Run RustOpViewer separately and keep its listener on loopback.
RELAYQUAY_APP_UPSTREAM=127.0.0.1:45080

RELAYQUAY_BIND=127.0.0.1
RELAYQUAY_LISTEN_PORT=8788
RELAYQUAY_STATE_DIR=/var/lib/relayquay
RELAYQUAY_RESTART_POLICY=unless-stopped
CLOUDFLARED_PROTOCOL=quic

# Set this only in the private copy.
CLOUDFLARE_TUNNEL_TOKEN=replace-me

CADDY_TAG=2-alpine
CLOUDFLARED_TAG=2026.6.1
